{
  "appId": "com.msync.app",
  "productName": "msync",
  "artifactName": "${name}.${ext}",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "sign": null,
    "signingHashAlgorithms": null,
    "signDlls": false
  },
  "nsis": {
    "artifactName": "${name}-setup.${ext}"
  },
  "portable": {
    "artifactName": "${name}.${ext}"
  },
  "mac": {
    "target": ["dmg"]
  },
  "linux": {
    "target": ["AppImage", "deb"]
  }
}
